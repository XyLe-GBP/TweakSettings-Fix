#!/bin/sh
set -eu
case "${1:-}" in
    configure) ;;
    *) exit 0 ;;
esac

PREFIX=/var/jb
UTILITY="$PREFIX/usr/bin/tweaksettings-utility"
APP="$PREFIX/Applications/TweakSettings.app"

# Never make a setuid executable writable by mobile or other users.
chown 0:0 "$UTILITY"
chmod 4755 "$UTILITY"
chown -R 0:0 "$APP"
chmod -R go-w "$APP"
chmod 0755 "$APP/TweakSettings"
if [ -x "$PREFIX/usr/bin/uicache" ]; then
    "$PREFIX/usr/bin/uicache" -p "$APP"
fi
